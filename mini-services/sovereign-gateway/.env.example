# SOVEREIGN GATEWAY — local OpenAI-compatible endpoint (brain #0 for everything)
# The service also auto-reads ../../.env.local and ../../.env (the vault-deployed
# office keys), so on the office machine this file can stay empty. Real env wins.
GATEWAY_PORT=3011
# Sovereign network discipline (owner-manifest aliases honored):
AI_TIMEOUT=60000
MAX_RETRIES=8
# REQUEST_TIMEOUT=90000        # alias of AI_TIMEOUT
# MAX_NETWORK_RETRIES=10       # alias of MAX_RETRIES
# AUTO_RECONNECT=true          # consumers' convention (documented in sovereign-agent.env)
# Lossy context compaction — chars budget per request (≈4 chars/token). 0 = off.
COMPACTION_BUDGET=24000
# Air-gapped fallback: any local OpenAI-compatible server (llama.cpp / llama-swap):
# LOCAL_LLM_URL=http://localhost:8080/v1
# LOCAL_LLM_KEY=unused
# LOCAL_LLM_MODELS=qwen-2.5-coder-32b,llama-3.3-70b-instruct
# ↑ HOST-TUNED values are generated by airgap/llama-host-config.sh → airgap/llama-host.env
#   (measures cgroup CPU/RAM honestly and picks the GGUF tier that fits; run
#   airgap/prepare-airgap.sh to verify reachability and download the model).
# Local reverse-engineered bridge (duckai — DuckDuckGo free AI backend, zero-auth).
# Copy of the source lives in ../duckai — run it on any machine WITH DDG access
# (from network-blocked sandboxes DDG is unreachable — honest limitation), then:
# DUCKAI_URL=http://127.0.0.1:3031/v1
# DUCKAI_MODELS=gpt-4o-mini,claude-3-5-haiku-latest,gpt-5-mini,mistralai/Mistral-Small-24B-Instruct-2501
